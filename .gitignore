# --- Секреты и локальное состояние ---
.env
.env.tmp

# --- Каталог изменяемых данных (база, фото, журналы, PID, токен) ---
# Рабочие данные перенесены в data/ (Этап 2.3). В репозитории остаётся
# только описание структуры.
data/*
!data/README.md

# --- Резервные копии переноса рабочих данных ---
backup/

# --- Прежние места рабочих данных (до переноса в data/) ---
# Оставлены в .gitignore, чтобы старые файлы не попали в репозиторий,
# если перенос выполняется на другой машине.
service.token
anpr_state.json
anpr_state.tmp
subscribers.json
subscribers.tmp
ui_preferences.json
ui_preferences.json.tmp
ui_window.json
ui_window.json.tmp
service.pid
anpr.sqlite3
anpr.sqlite3-shm
anpr.sqlite3-wal

# --- Фотографии проездов в прежней папке (до переноса в data/photos) ---
images/
# Диагностические снимки — служебные, удаляются после проверки.
images/diagnostic/
data/photos/diagnostic/

# --- Логи и окружение ---
*.log
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
build/
dist/
*.egg-info/

# --- Локальные заметки с доступами и персональными данными ---
PROJECT_CONTEXT.md
Dahua-API-Python-Integration.SKILL.md

# --- Локальные макеты и снимки экрана (не часть поставки) ---
*.pdf
*.html
evrika-*.png
*_ANPR_*.jpg

# --- Набор иконок Material Symbols: в репозитории только используемые ---
# Полный набор (~1050 файлов) нужен только для растеризации новых иконок.
filled/*
!filled/LICENSE
!filled/README.md
!filled/brand-messenger.svg
!filled/calendar-month.svg
!filled/camera.svg
!filled/send.svg
!filled/settings.svg
!filled/video.svg
!filled/search.svg
!filled/chart-area-line.svg
