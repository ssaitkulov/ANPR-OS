# Dahua ANPR камера
DAHUA_HOST=192.168.1.108
DAHUA_PORT=80
DAHUA_USERNAME=admin
DAHUA_PASSWORD=your_password_here
DAHUA_CHANNEL=1
# Полосы въезда, Lane в событиях с 0. Пусто = все полосы.
# Пример: ALLOWED_LANES=0  (только полоса 0)
ALLOWED_LANES=
# Пусто — оба направления; Approach — въезд; Leave — выезд.
DIRECTION=

# Telegram (получить токен у @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# Отчёт
REPORT_TIME=20:00
TIMEZONE=Asia/Tashkent
CAMERA_NAME=Fayz kırısh
DEDUP_WINDOW_SECONDS=15
# Каждый въезд -> фото + время в Telegram (true/false)
TELEGRAM_SEND_EACH_ENTRY=true
# Папка фотографий проездов (JPEG-файлы отдельно от базы).
IMAGE_DIR=images
# Сохранять ли снимки проездов на диск (true/false).
# true — мониторинг читает фото с диска; false — фото не пишутся,
# и в очереди недоставленных остаётся только текст проезда.
SAVE_PHOTOS=true
# Сколько дней хранить JSON-зеркало проездов. Постоянный архив — в SQLite.
STATE_KEEP_DAYS=30

# Backfill: добор пропущенного после обрыва одним списком
BACKFILL_ENABLED=true
# Для этой ITC413: архив хранит местное время в числовом поле Time.
BACKFILL_TIMESTAMP_MODE=local
# true — учитывать ручные снимки из веб-интерфейса камеры для тестирования.
INCLUDE_MANUAL_SNAPSHOTS=true
BACKFILL_LOOKBACK_MINUTES=180
BACKFILL_MAX_MINUTES=1440
BACKFILL_SEND_PHOTOS=false
# Как часто запускать добор архива, секунд (минимум 15).
BACKFILL_INTERVAL=60
# Как часто проверять очередь недоставленных сообщений, секунд (минимум 5).
OUTBOX_FLUSH_INTERVAL=15

# Рассылка подписчикам бота (/start в чате бота)
BROADCAST_ENABLED=true
SUBSCRIBERS_FILE=subscribers.json
# Только разрешённые чаты. Пустой список запрещает доступ и рассылку.
ALLOWED_CHAT_IDS=123456789
