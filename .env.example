# Dahua ANPR камера
DAHUA_HOST=192.168.1.108
DAHUA_PORT=80
DAHUA_USERNAME=admin
DAHUA_PASSWORD=your_password_here
DAHUA_CHANNEL=1
# Полосы въезда, Lane в событиях с 0. Пусто = все полосы.
# Пример: ALLOWED_LANES=0  (только полоса 0)
ALLOWED_LANES=
# Пусто — оба направления; Approach — въезд; Leave — выезд.
DIRECTION=

# Telegram (получить токен у @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# Отчёт
REPORT_TIME=20:00
# Как часто проверять время отчёта, с (отчёт отправляет отдельный поток).
REPORT_CHECK_INTERVAL=60
# Окно, в котором отчёт за день ещё можно отправить, мин (после REPORT_TIME).
REPORT_WINDOW_MINUTES=240
# Сколько дней хранить отметки об отправленных отчётах.
REPORT_KEEP_DAYS=30
TIMEZONE=Asia/Tashkent
CAMERA_NAME=Fayz kırısh
DEDUP_WINDOW_SECONDS=15
# Каждый въезд -> фото + время в Telegram (true/false)
TELEGRAM_SEND_EACH_ENTRY=true
# Папка фотографий проездов (JPEG-файлы отдельно от базы).
IMAGE_DIR=images
# Сохранять снимки проездов файлами в IMAGE_DIR (мониторинг читает их с диска).
# false — не сохранять: в мониторинге останутся только фото последних проездов.
SAVE_PHOTOS=true
# Сколько дней хранить JSON-зеркало проездов. Постоянный архив — в SQLite.
STATE_KEEP_DAYS=30
# Сколько дней хранить фотографии в IMAGE_DIR. Старые каталоги удаляет поток обслуживания.
IMAGE_RETENTION_DAYS=30
# Как часто удалять старые фотографии, с.
MAINTENANCE_INTERVAL=3600
# Как часто сливать WAL-файл базы в саму базу, с.
WAL_CHECKPOINT_INTERVAL=900

# Журналы: service.stdout.log и service.stderr.log ротируются по размеру.
# Один файл журнала — 10 МБ, хранится 3 старые копии (.1, .2, .3).
LOG_MAX_MB=10
LOG_BACKUPS=3

# Backfill: добор пропущенного после обрыва одним списком
BACKFILL_ENABLED=true
# Для этой ITC413: архив хранит местное время в числовом поле Time.
BACKFILL_TIMESTAMP_MODE=local
# true — учитывать ручные снимки из веб-интерфейса камеры для тестирования.
INCLUDE_MANUAL_SNAPSHOTS=true
BACKFILL_LOOKBACK_MINUTES=180
BACKFILL_MAX_MINUTES=1440
BACKFILL_SEND_PHOTOS=false
# Как часто запускать добор архива камеры, сек.
BACKFILL_INTERVAL=60
# Как часто доставлять накопленные сообщения очереди, сек (доставка не зависит от камеры).
OUTBOX_FLUSH_INTERVAL=15
# Сколько неудачных попыток доставки допускается до статуса dead (сообщение больше не отправляется).
OUTBOX_MAX_ATTEMPTS=10
# Пауза перед первой повторной попыткой, сек. Дальше — экспонента: 30, 60, 120, ...
OUTBOX_RETRY_BASE_SECONDS=30
# Потолок паузы между повторами, сек.
OUTBOX_RETRY_MAX_SECONDS=3600

# Рассылка подписчикам бота (/start в чате бота)
BROADCAST_ENABLED=true
SUBSCRIBERS_FILE=subscribers.json
# Только разрешённые чаты. Пустой список запрещает доступ и рассылку.
ALLOWED_CHAT_IDS=123456789
